# ==============================================================================
# APEXGEN 2.0 — DIGITAL STUDIO INFRASTRUCTURE ENVIRONMENT VARIABLES
# ==============================================================================
# Copy this file to .env.local for local development. Never commit .env.local to Git.

# --- Domain & SEO Configuration ---
# The canonical production base URL (used for canonical links, sitemaps, OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=https://www.apexgen.website

# --- Communication Channels ---
# Studio WhatsApp contact number (international format with country code: +94...)
NEXT_PUBLIC_WHATSAPP_NUMBER=+94770289139

# --- Analytics & Telemetry (Optional) ---
# Google Analytics 4 Measurement ID (e.g., G-ABC123XYZ)
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML verification tag value
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Client Conversion & Webhook Infrastructure ---
# Endpoint to receive formatted JSON lead payloads (Slack, Discord, Zapier, Make, n8n, CRM)
LEAD_NOTIFICATION_WEBHOOK=

# Email notification dispatch via Resend (optional)
RESEND_API_KEY=
INQUIRY_NOTIFICATION_EMAIL=subash.apexgen@gmail.com

# Studio Admin Token (for protected API endpoints / inquiry management)
ADMIN_SECRET_KEY=
